# SILLEAU Framework — environment variables
#
# Copy to .env.local și completează valorile reale.
# Pe producție, variabilele se setează prin `supabase secrets set`.

# ─── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Public URL (folosit în email-uri, redirect-uri) ───────────────────────
# Reverse proxy (Cloudflare Pages / Vercel) traduce /r/{c|r|x}/* și /f/* către
# Supabase Edge Functions — vezi README.md secțiunea „Reverse Proxy".
SITE_URL=https://www.silleau.com

# ─── Domenii acceptate de CORS pe save-booking / resolve-action ────────────
ALLOWED_ORIGINS=https://www.silleau.com,https://silleau.com

# ─── Salt-uri pentru hash-uri server-side (NU le rota după deploy) ─────────
# openssl rand -base64 48
TOKEN_HASH_SALT=<random-48-bytes-base64>
IP_HASH_SALT=<random-48-bytes-base64>

# ─── HMAC secret pentru token-urile de feedback (din reminder emails) ──────
# openssl rand -hex 32
FEEDBACK_TOKEN_SECRET=<random-64-hex-chars>

# ─── Third-party ───────────────────────────────────────────────────────────
RESEND_KEY=re_...
META_WA_TOKEN=EAA...
META_WA_PHONE_ID=1234567890
